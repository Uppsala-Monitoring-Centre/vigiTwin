{# Index over the generated evidence reviews. Links only the files written. #}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1" name="viewport"/>
<title>{{ vm.title }}</title>
<style>
{% include "_evidence.css.j2" %}
</style>
</head>
<body>
<main>
  <div class="kicker">Evidence review</div>
  <h1>{{ vm.title }}</h1>
  <p class="note">
    {{ vm.items | length }} example{{ '' if vm.items | length == 1 else 's' }}{% if vm.generated_at %} · generated {{ vm.generated_at }}{% endif %}.
  </p>
  {% if vm.document_filename %}
  {#
    Above the table, because for a curated collection the combined document
    is the artifact and the per-example pages are the way round it.
  #}
  <p class="intro">
    Every example in one document:
    <a href="{{ vm.document_filename }}">{{ vm.document_filename }}</a>.
  </p>
  {% endif %}
  <table>
    <thead>
      <tr>
        <th scope="col">Example</th>
        <th scope="col">Title</th>
        <th scope="col">Reference</th>
        <th scope="col">vigiTwin</th>
      </tr>
    </thead>
    <tbody>
      {% for item in vm.items %}
      <tr>
        <td><a href="{{ item.filename }}">{{ item.example_label or item.example_id }}</a>
          {% if item.kicker %}<small class="subtle">{{ item.kicker }}</small>{% endif %}
        </td>
        <td>{{ item.title or item.pair_id }}</td>
        <td>{{ item.reference_label or "—" }}</td>
        <td>{{ item.final_label or "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <footer>
    Generated by vigitwin.review_html, evidence format.
    {#
      Branched for the same reason the page footer is. This asserted an
      internal review whatever directory it sat in, so every publication
      output directory held one file contradicting its own manifest and every
      page beside it.
    #}
    {% if vm.mode.value == 'publication' %}
    {% if vm.approved_for_release %}
    Cleared for public sharing by the study's disclosure reviewer.
    {% else %}
    Prepared for publication: a candidate for disclosure review, not a
    document certified as anonymised.
    {% endif %}
    {% else %}
    Internal evidence review; not a publication-safe document.
    {% endif %}
  </footer>
</main>
</body>
</html>
