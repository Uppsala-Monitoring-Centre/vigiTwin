{# Stylesheet for the evidence review. Kept in its own partial so the page and
   a future multi-case supplement share one source of truth, and so the print
   rules below are not diluted by the detailed format's screen styling. #}
:root{
  --ink:#172b39; --muted:#50606c; --line:#d4dee3; --accent:#17576a;
  --pale:#eaf3f5; --paper:#fff;
  /* Evidence palette. Green: matching evidence or anchor pattern.
     Red: a retained inconsistency. Everything else is neutral. */
  --match:#17604c; --mismatch:#a12632;
  --match-bg:#e9f5ed; --mismatch-bg:#fbecef;
}
*{box-sizing:border-box}
body{
  font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:#edf1f3;
  margin:0;font-size:15px;line-height:1.5;
}
main{
  max-width:980px;margin:30px auto;background:var(--paper);padding:42px 54px;
  box-shadow:0 2px 18px #0001;
}
h1{font-size:30px;line-height:1.15;letter-spacing:-.5px;margin:7px 0 15px}
h2{font-size:24px;line-height:1.2;margin:0 0 12px}
h3{
  font-size:17px;margin:24px 0 8px;color:var(--accent);
  border-bottom:1px solid var(--line);padding-bottom:5px;
}
h4{font-size:14px;margin:18px 0 6px;color:var(--accent)}
.kicker{
  font-size:11px;text-transform:uppercase;letter-spacing:1.5px;
  font-weight:bold;color:var(--accent);
}
/*
  The example label reads as part of the heading rather than as a badge beside
  it: it is what surrounding text cites the case as. The position is muted and
  stays in the kicker line, where it cannot be mistaken for the label.
*/
.example-label{color:var(--accent)}
.position{font-weight:normal;letter-spacing:0.5px;color:var(--muted)}
/*
  The reporting context opens the independence section and is read, not
  skimmed past: body size rather than the muted note size it had while it sat
  under the comparison table.
*/
.context{max-width:760px}
/* The contributions table's total: ruled off, so it reads as a sum. */
table tfoot td{border-top:2px solid var(--line);font-weight:bold}
.intro{color:var(--muted);max-width:760px}
.case{margin-top:32px;border-top:3px solid var(--accent);padding-top:18px}
.lede{font-size:16px;margin:8px 0 15px}

/* Header tiles. Four sources of classification, kept visually apart. */
.outcomes{
  display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px;
  margin:14px 0 16px;
}
.outcome{border:1px solid var(--line);padding:10px 12px;background:#f7f9fa}
.outcome span{display:block;font-size:11px;color:var(--muted);font-weight:bold}
.outcome strong{font-size:16px;display:block;line-height:1.25;margin-top:3px}
.outcome strong.tile-absent{color:var(--muted);font-weight:normal;font-size:14px}

/* The two decision stages. Deliberately the most prominent thing after the
   outcome tiles: a reader's first question is what was decided and on what,
   and the page used to answer the second only by implication. Both tiles
   take the same shape whichever route they took, so a shared-source
   decision reads as firmly as a rarity calculation. */
.decisions{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));
  gap:12px;margin:0 0 16px;
}
.decision{
  border:1px solid var(--line);border-left:4px solid var(--muted);
  padding:10px 12px;background:#fbfcfd;
}
.decision p{margin:0 0 4px}
.decision p:last-child{margin-bottom:0}
.decision-absent{background:#fafbfb}
.decision-stage{font-size:11px;color:var(--muted);font-weight:bold;
  text-transform:uppercase;letter-spacing:.04em}
.decision-outcome{font-size:18px;font-weight:600;line-height:1.25}
.decision-absent .decision-outcome{color:var(--muted);font-weight:normal;font-size:14px}
.decision-basis{font-size:14px}
.decision-note{font-size:12.5px;color:#4a5761}
.pathway{
  display:inline-block;font-size:11px;font-weight:bold;text-transform:uppercase;
  letter-spacing:.04em;padding:2px 7px;border-radius:9px;
  background:#eceff1;color:var(--muted);
}
/* Coloured by which way the decision went, not by which route it took. A
   badge coloured per pathway said a shared-source decision and a rarity
   decision were different kinds of thing, which is not what a reader needs
   from a colour; whether the outcome counts towards one case is. The same
   two colours the tables use, so there is one colour rule on the page. */
.pathway.value-match{background:var(--match-bg);color:var(--match)}
.pathway.value-mismatch{background:var(--mismatch-bg);color:var(--mismatch)}
.decision.value-match{border-left-color:var(--match)}
.decision.value-mismatch{border-left-color:var(--mismatch)}
.decision-absent.value-match,.decision-absent.value-mismatch,
.decision-absent{border-left-color:var(--muted)}

/* Tables */
table{
  border-collapse:collapse;width:100%;font-size:13px;line-height:1.4;
  margin:8px 0 12px;table-layout:fixed;
}
th,td{
  text-align:left;vertical-align:top;padding:7px 9px;
  border-bottom:1px solid var(--line);overflow-wrap:anywhere;
}
th{background:var(--pale);color:var(--ink);font-size:12px}
.characteristics th:first-child{width:24%}
.drugs th:nth-child(1),.drugs th:nth-child(2){width:40%}
.drugs th:nth-child(3){width:20%}
.aes th:nth-child(1),.aes th:nth-child(2){width:40%}
.aes th:nth-child(3){width:20%}
.findings th:nth-child(1){width:20%}
.findings th:nth-child(2){width:14%}
.freq th:first-child{width:34%}
/* The context table says which of its own rows the assessment used, so the
   section needs no paragraph above it pointing at one. The shading marks the
   reporting context; the box marks the count that became the anchor
   population. Neither is green or red: a population size is not evidence for
   the pair or against it, and spending one of the page's two colours on it
   would make the colour rule mean two things. */
.freq tr.scope-selected td{background:var(--pale)}
.freq tr.scope-selected td:first-child{font-weight:bold}
/* A border rather than an inset shadow: a shadow is the kind of decoration a
   print engine is free to drop, and this one carries meaning. */
.freq td.anchor-count{
  font-weight:bold;color:var(--accent);border:2px solid var(--accent);
}
.decision td:first-child,.decision th:first-child{width:28%}
.decision td:first-child{font-weight:bold}

/* Evidence colouring. These three classes are the whole visual vocabulary;
   they are set from EvidenceRole, never from a value comparison. */
.value-match{color:var(--match);font-weight:600}
.value-mismatch{color:var(--mismatch);font-weight:600}
.value-neutral{color:var(--ink)}
.absent,.withheld{color:#687681;font-style:italic}
tr.row-match td,tr.ae-match td{background:var(--match-bg)}
tr.row-mismatch td,tr.ae-mismatch td{background:var(--mismatch-bg)}
tr.row-neutral td,tr.ae-neutral td{background:transparent}

/* One reported drug record, read top-down in order of what the assessment
   makes of it: dates, then role, then the detail it does not consider. */
.entry{margin-top:4px}
.entry+.entry{border-top:1px dotted #c9d5da;padding-top:4px}
.entity-name{font-weight:600;margin-bottom:2px}
.entry-dates{font-size:12px}
.entry-role{font-size:12px}
/* Strength and formulation are reported information, shown faintly because
   vigiTwin does not consider them — neither as matching evidence nor as a
   possible inconsistency. */
.entry-detail{font-size:11px;color:var(--muted)}
.subtle{display:block;margin:2px 0 3px;font-size:11px;color:var(--muted)}
.note{font-size:12px;color:var(--muted)}
.comparison-key{font-size:12px;color:var(--muted);margin:8px 0 14px}
.comparison-key span{margin-right:12px}
.callout{
  border-left:3px solid var(--accent);padding:8px 14px;background:#f3f8f9;
  margin:14px 0;
}
.callout p{margin:5px 0}
.label{font-weight:bold;color:var(--accent)}
/* The at-a-glance panel. A bordered block rather than a table, because it
   sits above the numbered sections and must not read as a fourth one; the
   two-column grid matches the width of the decision column it replaced. */
.chain{
  border:1px solid var(--line);border-left:3px solid var(--accent);
  padding:10px 14px 12px;background:#fbfdfd;margin:14px 0;
}
.chain dl{
  display:grid;grid-template-columns:28% 1fr;gap:4px 14px;
  font-size:13px;line-height:1.45;margin:6px 0 0;
}
.chain dt{font-weight:bold;color:var(--muted)}
.chain dd{margin:0}
/* One chip per piece of evidence, so the panel reads as countable items
   rather than as a sentence. Two colours only, never shaded by magnitude:
   colour says which way a piece told, and the figure inside says how much.
   Shading by size would make a pale chip and a small number the same
   statement twice, and would put the page's one severity claim in a place
   a reader cannot measure. */
.chip{
  display:inline-block;margin:0 5px 3px 0;padding:2px 7px;border-radius:3px;
  font-size:12px;line-height:1.35;
}
/* The figure needs air from the value beside it. A signed contribution
   separated itself with its "+"; an unsigned penalty weight does not, and
   "2005 1.2" read as one number. */
.chip b{font-weight:bold;margin-left:7px}
.chip-for{background:var(--match-bg);color:var(--match);border:1px solid #cfe6d8}
.chip-against{
  background:var(--mismatch-bg);color:var(--mismatch);border:1px solid #f0cdd4;
}
/* A value inside a chip is already the chip's colour; the cell's own class
   would restate it at a different weight. */
.chip .value-match,.chip .value-mismatch,.chip .value-neutral{
  color:inherit;font-weight:inherit;
}
/* The clause under a decision figure: why that number decided what it did.
   Set apart so the figure stays scannable and the reasoning stays available
   without a second table. */
.chain-note{display:block;font-size:12px;color:var(--muted);margin-top:1px}
/* The two shared sets side by side, drugs left and adverse events right, in
   the column order of the counts table directly beneath them. Stacked, a
   reader had to hold the drug set in mind while scrolling past the AE set to
   reach the row of numbers that counts both. `grid-auto-flow: column` over
   two rows puts each set's heading above its own members. */
.set-list{
  display:grid;grid-template-columns:1fr 1fr;grid-template-rows:auto auto;
  grid-auto-flow:column;gap:2px 24px;
  font-size:13px;line-height:1.5;margin:8px 0 12px;
}
.set-list dt{font-weight:bold}
.set-list dd{margin:2px 0 0}
.evidence-snippets{font-size:11px;color:var(--muted);margin-top:3px}
.gaps{
  margin:18px 0 0;padding:10px 14px;border:1px solid var(--line);
  background:#fcfdfd;font-size:12px;color:var(--muted);
}
.gaps ul{margin:5px 0 0;padding-left:18px}
.reconciliation{font-size:12px;color:var(--muted);margin:6px 0 12px}
/* The agreement line sits directly under the outcome tiles, because that is
   the row it is about: it compares two of the four verdicts printed there.
   Pulled up against them so it reads as part of that row rather than as the
   first thing in the decisions block beneath it. */
.verdict-note{margin:-8px 0 14px}
.verdict-agree{color:var(--match);font-weight:600}
.verdict-disagree{color:var(--mismatch);font-weight:600}
/* The publication band. Full width at the top of the page, in the colour the
   page already uses for "counts against", because that is the only strong
   colour here a reader has already been taught. The word is large and
   letter-spaced so it survives being screenshotted, scaled into a figure or
   printed in grey. */
.masked-banner{
  display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;
  margin:0 0 22px;padding:10px 16px;
  background:var(--mismatch);color:#fff;
}
.masked-word{
  font-size:22px;font-weight:bold;text-transform:uppercase;letter-spacing:4px;
  line-height:1.1;
}
.masked-detail{font-size:11.5px;line-height:1.35;max-width:620px}
footer{
  margin-top:34px;padding-top:12px;border-top:1px solid var(--line);
  font-size:11px;color:var(--muted);
}
a{color:var(--accent)}
/* The repeating per-sheet footer is for paper only. Hidden here, outside
   @media print, and deliberately so: no rule inside the print block may hide
   content, and a test asserts the print block contains no display:none. On
   screen the flowed <footer> already carries the same claim. */
.page-footer{display:none}

@media(max-width:650px){
  main{padding:20px;margin:0}
  .masked-word{font-size:18px;letter-spacing:3px}
  .outcomes,.decisions{grid-template-columns:1fr}
  .chain dl{grid-template-columns:1fr;gap:1px 0}
  .chain dt{margin-top:7px}
  .set-list{grid-template-columns:1fr;grid-auto-flow:row;gap:0}
  .set-list dt{margin-top:7px}
  table{font-size:12px}
  th,td{padding:5px}
  h1{font-size:25px}
}

/* Print. Sized for A4 and for a reviewer who will read this on paper:
   headings stay with their tables, table headings repeat across pages, long
   terms wrap rather than overflow, and narratives are never clipped. */
@page{size:A4;margin:16mm 16mm 28mm}
@media print{
  body{background:#fff;font-size:10pt;line-height:1.4}
  main{margin:0;padding:0;max-width:none;box-shadow:none}
  h1{font-size:23pt}
  h2{font-size:18pt}
  h3{break-after:avoid;font-size:12pt}
  h4{break-after:avoid}
  table{font-size:9pt}
  th{font-size:8.5pt}
  th,td{padding:5px 6px}
  thead{display:table-header-group}
  tr{break-inside:avoid}
  /* Every example opens a sheet, the first included, so the collection's
     front matter gets one of its own. Scoped with :not(:only-of-type) rather
     than written as a bare .case rule because a per-pair page holds exactly
     one case, and breaking before it would print a near-empty first sheet. */
  .case:not(:only-of-type){break-before:page}
  .case{margin-top:20px}
  /* Opening a sheet, so its top rule would print under nothing. */
  .case:not(:only-of-type){margin-top:0;border-top:none;padding-top:0}
  .outcomes,.decisions,.decision,.callout,.gaps,.chain{break-inside:avoid}
  /* The band is the one element on the page whose absence changes what the
     document claims, so it is kept whole and its colour is forced (the
     print-colour rule below covers it, but a grey band with white text
     would still read). */
  .masked-banner{break-inside:avoid;break-after:avoid}
  /* Long narratives and interpretations must not be cut off mid-sentence. */
  .callout p,.narrative-text{overflow:visible;break-inside:auto}
  a{text-decoration:none;color:inherit}
  /* Repeated on every sheet: Chrome paints a fixed element once per page.
     It sits in the enlarged bottom margin — pulled below the page area that
     content flows through — so it cannot cover a line of the document. The
     text is static by necessity: @page margin boxes and counter(page) are
     unreachable from here, so there is no page number and cannot be. */
  .page-footer{
    display:block;position:fixed;left:0;right:0;bottom:-14mm;
    height:9mm;padding-top:2mm;overflow:hidden;
    border-top:1px solid var(--line);background:var(--paper);
    font-size:7.5pt;line-height:1.3;color:var(--muted);
  }
  *{print-color-adjust:exact;-webkit-print-color-adjust:exact}
}
