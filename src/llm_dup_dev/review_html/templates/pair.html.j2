<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Pair Review: {{ vm.pair_id }}</title>
<style>
/* --- Base --- */
*, *::before, *::after { box-sizing: border-box; }
body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #24292e;
    background: #f6f8fa;
    margin: 0;
    padding: 20px;
}
h1 { font-size: 1.5rem; margin: 0 0 4px; }
h2 { font-size: 1.15rem; margin: 24px 0 8px; border-bottom: 1px solid #d1d5da; padding-bottom: 4px; }

/* --- Header --- */
.header {
    background: #fff;
    border: 1px solid #d1d5da;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 16px;
}
.header .pair-id { font-weight: 600; }
.header .report-ids { color: #586069; font-size: 0.92em; }
.header .external-link { font-size: 0.88em; margin-top: 4px; }
.header .external-link a { color: #0366d6; text-decoration: none; }
.header .external-link a:hover { text-decoration: underline; }

/* --- Section cards --- */
.section {
    background: #fff;
    border: 1px solid #d1d5da;
    border-radius: 6px;
    padding: 12px 20px 16px;
    margin-bottom: 16px;
}

/* --- Tables --- */
.table-scroll { overflow-x: auto; }
table {
    border-collapse: collapse;
    width: 100%;
    font-size: 13px;
}
th, td {
    border: 1px solid #d1d5da;
    padding: 6px 10px;
    text-align: left;
    vertical-align: top;
}
thead th {
    background: #f1f3f5;
    font-weight: 600;
    position: sticky;
    top: 0;
}

/* --- Row-level comparison-status colours --- */
tr.match td { background: #d4edda; }
tr.partial_match td { background: #fff3cd; }
tr.mismatch td { background: #f8d7da; }
tr.missing_left td { background: #e8eaed; }
tr.missing_right td { background: #e8eaed; }
tr.informational td { background: #d1ecf1; }
/* neutral: no background colour, just the status badge */
tr.neutral td { background: inherit; }

/* Status indicator column */
th.status-col, td.status-col { width: 56px; text-align: center; white-space: nowrap; }
.status-label {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 5px;
    border-radius: 3px;
}
.status-label-match { background: #155724; color: #fff; }
.status-label-partial_match { background: #856404; color: #fff; }
.status-label-mismatch { background: #721c24; color: #fff; }
.status-label-missing_left { background: #383d41; color: #fff; }
.status-label-missing_right { background: #383d41; color: #fff; }
.status-label-informational { background: #0c5460; color: #fff; }

/* --- Drug / AE detail blocks inside cells --- */
.detail-block {
    padding: 2px 0;
    font-size: 12px;
    line-height: 1.6;
}
.detail-block + .detail-block {
    border-top: 1px dashed #d1d5da;
    margin-top: 4px;
    padding-top: 4px;
}
.detail-label {
    color: #586069;
    font-size: 11px;
}
/* Sub-field inline coloring within drug cells */
.sf-match { color: #155724; font-weight: 600; }
.sf-mismatch { color: #721c24; font-weight: 600; }
.sf-missing_left, .sf-missing_right { color: #6c757d; font-style: italic; }
.sf-partial_match { color: #856404; }

/* Drug / AE name coloring in key column */
.name-match { color: #155724; font-weight: 700; }
.name-partial_match { color: #24292e; font-weight: 700; }
.name-mismatch { color: #721c24; font-weight: 700; }
.name-missing_left { color: #721c24; font-weight: 700; }
.name-missing_right { color: #721c24; font-weight: 700; }
.name-neutral { color: #24292e; font-weight: 700; }

/* --- Narrative side-by-side --- */
.narrative-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}
.narrative-col {
    background: #f6f8fa;
    border: 1px solid #d1d5da;
    border-radius: 4px;
    padding: 10px 12px;
    white-space: pre-wrap;
    font-size: 13px;
    max-height: 400px;
    overflow-y: auto;
}
.narrative-col-header {
    font-weight: 600;
    margin-bottom: 6px;
    font-size: 12px;
    color: #586069;
}

/* --- Evidence summary --- */
.evidence-kv { display: grid; grid-template-columns: 180px 1fr; gap: 2px 12px; font-size: 13px; margin-bottom: 10px; }
.evidence-kv dt { font-weight: 600; color: #586069; }
.evidence-kv dd { margin: 0; }

.severity-minor,
.severity-moderate,
.severity-strong,
.severity-decisive {
    display: inline-block;
    padding: 1px 5px;
    border-radius: 3px;
    color: #fff;
    font-weight: 600;
}
.severity-minor    { background: #b8860b; }
.severity-moderate { background: #e67e22; }
.severity-strong   { background: #c0392b; }
.severity-decisive { background: #7b2cbf; font-weight: 700; }

/* --- Suppressed inconsistency rows (kept for transparency) --- */
tr.inc-suppressed td { color: #959da5; background: #fafbfc; }
tr.inc-suppressed .severity-minor,
tr.inc-suppressed .severity-moderate,
tr.inc-suppressed .severity-strong,
tr.inc-suppressed .severity-decisive { background: #b1b4b8; color: #fff; }
.suppressed-badge {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    padding: 1px 5px;
    border-radius: 3px;
    background: #e2e3e5;
    color: #383d41;
    margin-left: 6px;
    text-transform: uppercase;
    letter-spacing: 0.02em;
}

/* --- AE clinical-picture status / counts panel --- */
.ae-cp-panel {
    margin: 8px 0 10px;
    padding: 8px 10px;
    background: #f6f8fa;
    border: 1px solid #d1d5da;
    border-radius: 4px;
    font-size: 13px;
}
.ae-cp-panel .label { font-weight: 600; color: #586069; margin-right: 6px; }
.ae-cp-status-assessed {
    display: inline-block;
    background: #155724;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 3px;
}
.ae-cp-status-not_assessed {
    display: inline-block;
    background: #6c757d;
    color: #fff;
    font-size: 11px;
    font-weight: 600;
    padding: 1px 6px;
    border-radius: 3px;
}
.inc-rationale {
    color: #586069;
    font-size: 12px;
    margin-top: 2px;
    font-style: italic;
}
.inc-terms {
    color: #586069;
    font-size: 12px;
    margin-top: 2px;
}

/* --- Classification badge --- */
.label-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-weight: 600;
    font-size: 13px;
}
.label-Duplicates { background: #d4edda; color: #155724; }
.label-Otherwise_related { background: #fce4ec; color: #880e4f; }
.label-Unrelated { background: #721c24; color: #fff; }
.label-Abstain { background: #e2e3e5; color: #383d41; }

/* --- Annotation badge --- */
.annotation-agree { color: #155724; font-weight: 700; font-size: 13px; }
.annotation-disagree { color: #721c24; font-weight: 700; font-size: 13px; }
.annotation-no-pipeline { color: #586069; font-size: 13px; }

/* --- Decision summary panel --- */
.decision-summary {
    background: #f1f3f5;
    border: 2px solid #d1d5da;
    border-radius: 6px;
    padding: 12px 20px;
    margin-bottom: 16px;
}
.decision-summary h2 { margin-top: 0; border-bottom: none; }
.decision-kv { display: grid; grid-template-columns: 160px 1fr; gap: 2px 12px; font-size: 13px; }
.decision-kv dt { font-weight: 600; color: #586069; }
.decision-kv dd { margin: 0; }

/* --- Collapsible debug sections --- */
details.debug-section { margin-top: 8px; }
details.debug-section summary {
    cursor: pointer; font-size: 13px; color: #586069; font-weight: 600;
    padding: 4px 0;
}
details.debug-section pre {
    background: #f6f8fa; border: 1px solid #d1d5da; border-radius: 4px;
    padding: 10px 12px; font-size: 12px; overflow-x: auto;
    max-height: 500px; overflow-y: auto;
}

/* --- Print --- */
@media print {
    body { background: #fff; padding: 0; }
    .section { break-inside: avoid; border: 1px solid #ccc; }
}
</style>
</head>
<body>

{# ── Macro: join a list of strings as "A", "A and B", "A, B, and C" ── #}
{% macro join_and(items) -%}
  {%- if not items -%}
  {%- elif items|length == 1 -%}
    {{- items[0] -}}
  {%- elif items|length == 2 -%}
    {{- items[0] }} and {{ items[1] -}}
  {%- else -%}
    {{- items[:-1]|join(', ') }}, and {{ items[-1] -}}
  {%- endif -%}
{%- endmacro %}

{# ── Macro: status label badge ── #}
{% macro status_badge(status) -%}
<span class="status-label status-label-{{ status.value }}">{{ status_icon(status) }}</span>
{%- endmacro %}

{# ── Macro: sub-field value with inline coloring ── #}
{% macro sf_value(value, sf_status) -%}
{% if value %}
{% if sf_status %}
<span class="sf-{{ sf_status.value }}">{{ value }}</span>
{% else %}
{{ value }}
{% endif %}
{% endif %}
{%- endmacro %}

{# ── Macro: drug/AE date range as (start — end) / (start — ?) / (? — end) ── #}
{# For drugs (both dates possible); pass sf_start / sf_end for coloring.      #}
{# For AEs (start only); pass end=none.                                        #}
{% macro date_range(start, end, sf_start=none, sf_end=none) -%}
{%- if start or end -%}
  {%- set s = start or '?' -%}
  {%- set e = end or '?' -%}
  {%- if start and end -%}
    {%- set dstr = '(' + s + ' \u2014 ' + e + ')' -%}
  {%- elif start and not end -%}
    {%- set dstr = '(' + s + ' \u2014 ?)' -%}
  {%- else -%}
    {%- set dstr = '(? \u2014 ' + e + ')' -%}
  {%- endif -%}
  {# Derive CSS class from the more alarming date sub-field status #}
  {%- set st_val = sf_start.value if sf_start else '' -%}
  {%- set en_val = sf_end.value   if sf_end   else '' -%}
  {%- if 'mismatch' in [st_val, en_val] -%}
    {%- set dcss = 'sf-mismatch' -%}
  {%- elif 'match' in [st_val, en_val] -%}
    {%- set dcss = 'sf-match' -%}
  {%- else -%}
    {%- set dcss = '' -%}
  {%- endif -%}
  {%- if dcss %}<span class="{{ dcss }}">{{ dstr }}</span>{%- else %}{{ dstr }}{%- endif -%}
{%- endif %}
{%- endmacro %}

{# ── Header ── #}
<div class="header">
    <h1 class="pair-id">Pair: {{ vm.pair_id }}</h1>
    <div class="report-ids">
        Report 1: <strong>{{ vm.report_1_id }}</strong>
        &nbsp;|&nbsp;
        Report 2: <strong>{{ vm.report_2_id }}</strong>
    </div>
    {% if vm.external_url %}
    <div class="external-link">
        <a href="{{ vm.external_url }}" target="_blank" rel="noopener">&#x1F517; {{ vm.external_url_label }}</a>
    </div>
    {% endif %}
    {% if vm.classification_summary %}
    <div style="margin-top: 6px;">
        Pipeline:
        <span class="label-badge label-{{ vm.classification_summary.final_label }}">
            {{ vm.classification_summary.final_label }}
        </span>
        {% if vm.features_summary %}
        &nbsp; L<sub>match</sub> = {{ "%.2f"|format(vm.features_summary.l_match) }}
        {% endif %}
        {% if vm.annotation %}
        &nbsp;&nbsp;
        Human:
        <span class="label-badge label-{{ vm.annotation.normalised_label }}">{{ vm.annotation.normalised_label }}</span>
        {% if vm.annotation.agrees_with_pipeline is not none %}
        {% if vm.annotation.agrees_with_pipeline %}
        <span class="annotation-agree">&#10003; agree</span>
        {% else %}
        <span class="annotation-disagree">&#10007; disagree</span>
        {% endif %}
        {% endif %}
        {% endif %}
    </div>
    {% elif vm.annotation %}
    <div style="margin-top: 6px;">
        Human annotation:
        <span class="label-badge label-{{ vm.annotation.normalised_label }}">{{ vm.annotation.normalised_label }}</span>
    </div>
    {% endif %}
</div>

{# ── Decision summary (prediction/evaluation mode) ── #}
{% if vm.decision_summary %}
<div class="decision-summary">
    <h2>Decision Summary</h2>
    <dl class="decision-kv">
        <dt>Final label</dt>
        <dd>
            <span class="label-badge label-{{ vm.decision_summary.final_label }}">
                {{ vm.decision_summary.final_label }}
            </span>
        </dd>
        {% if vm.decision_summary.duplicate_relationship %}
        <dt>Relationship</dt>
        <dd>{{ vm.decision_summary.duplicate_relationship }}</dd>
        {% endif %}
        {% if vm.decision_summary.l_match is not none %}
        <dt>L<sub>match</sub></dt>
        <dd>{{ "%.4f"|format(vm.decision_summary.l_match) }}</dd>
        {% endif %}
        {% if vm.decision_summary.inconsistency_counts %}
        {%- set ic = vm.decision_summary.inconsistency_counts %}
        <dt>Inconsistencies</dt>
        <dd>{{ ic.minor }} minor, {{ ic.moderate }} moderate, {{ ic.strong }} strong, {{ ic.decisive }} decisive</dd>
        {% endif %}
        {% if vm.decision_summary.clinical_date_counts and vm.decision_summary.clinical_date_counts.total > 0 %}
        {%- set cdc = vm.decision_summary.clinical_date_counts %}
        <dt style="font-size: 0.85em; padding-left: 8px;">of which clinical dates</dt>
        <dd style="font-size: 0.85em;">{{ cdc.n_minor }} minor, {{ cdc.n_moderate }} moderate, {{ cdc.n_strong }} strong, {{ cdc.n_decisive }} decisive</dd>
        {% endif %}
        {% if vm.decision_summary.ae_clinical_picture_counts and vm.decision_summary.ae_clinical_picture_counts.total > 0 %}
        {%- set acp = vm.decision_summary.ae_clinical_picture_counts %}
        <dt style="font-size: 0.85em; padding-left: 8px;">of which AE clinical-picture</dt>
        <dd style="font-size: 0.85em;">{{ acp.n_minor }} minor, {{ acp.n_moderate }} moderate, {{ acp.n_strong }} strong, {{ acp.n_decisive }} decisive</dd>
        {% elif vm.decision_summary.ae_clinical_picture_status == 'not_assessed' %}
        <dt style="font-size: 0.85em; padding-left: 8px;">AE clinical-picture</dt>
        <dd style="font-size: 0.85em; color: #586069;">not assessed</dd>
        {% endif %}
        {% if vm.decision_summary.narrative_consistency %}
        <dt>Narrative</dt>
        <dd>{{ vm.decision_summary.narrative_consistency }}</dd>
        {% endif %}
        <dt>Explanation</dt>
        <dd>{{ vm.decision_summary.explanation }}</dd>
        {% if vm.decision_summary.penalty_summary %}
        <dt>Penalty</dt>
        <dd>{{ vm.decision_summary.penalty_summary }}</dd>
        {% endif %}
    </dl>
</div>
{% endif %}

{# ── Demographics comparison ── #}
{% if vm.demographics %}
<div class="section">
    <h2>Demographics &amp; Report Metadata</h2>
    <div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Field</th>
                <th>Report 1: {{ vm.report_1_id }}</th>
                <th>Report 2: {{ vm.report_2_id }}</th>
                <th class="status-col"></th>
            </tr>
        </thead>
        <tbody>
        {% for f in vm.demographics %}
            <tr class="{{ f.status.value }}"{% if f.tooltip %} title="{{ f.tooltip }}"{% endif %}>
                <td>{{ f.label }}</td>
                <td><span class="name-{{ f.status.value }}">{{ f.left_display | safe }}</span></td>
                <td><span class="name-{{ f.status.value }}">{{ f.right_display | safe }}</span></td>
                <td class="status-col">{{ status_badge(f.status) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endif %}

{# ── Drugs comparison ── #}
{% if vm.drugs %}
<div class="section">
    <h2>Drugs ({{ vm.drugs|length }})</h2>
    <div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Substance</th>
                <th>Report 1: {{ vm.report_1_id }}</th>
                <th>Report 2: {{ vm.report_2_id }}</th>
                <th class="status-col"></th>
            </tr>
        </thead>
        <tbody>
        {% for drug in vm.drugs %}
            <tr class="{{ drug.status.value }}">
                <td><strong class="name-{{ drug.status.value }}">{{ drug.substance }}</strong></td>
                <td>
                    {% for d in drug.left_details %}
                    {%- set sf = d.subfield_status %}
                    <div class="detail-block">
                        <span class="name-{{ drug.status.value }}">{{ d.substance }}</span>
                        {%- if d.start_date or d.end_date %}
                        <br>{{ date_range(d.start_date, d.end_date,
                                sf.start_date if sf else none,
                                sf.end_date   if sf else none) }}
                        {%- endif %}
                        {%- if d.role %}<br>{{ sf_value(d.role, sf.role if sf else none) }}{% endif %}
                        {%- if d.form %}<br>{{ sf_value(d.form, sf.form if sf else none) }}{% endif %}
                        {%- if d.strength %}<br>{{ sf_value(d.strength, sf.strength if sf else none) }}{% endif %}
                    </div>
                    {% endfor %}
                </td>
                <td>
                    {% for d in drug.right_details %}
                    {%- set sf = d.subfield_status %}
                    <div class="detail-block">
                        <span class="name-{{ drug.status.value }}">{{ d.substance }}</span>
                        {%- if d.start_date or d.end_date %}
                        <br>{{ date_range(d.start_date, d.end_date,
                                sf.start_date if sf else none,
                                sf.end_date   if sf else none) }}
                        {%- endif %}
                        {%- if d.role %}<br>{{ sf_value(d.role, sf.role if sf else none) }}{% endif %}
                        {%- if d.form %}<br>{{ sf_value(d.form, sf.form if sf else none) }}{% endif %}
                        {%- if d.strength %}<br>{{ sf_value(d.strength, sf.strength if sf else none) }}{% endif %}
                    </div>
                    {% endfor %}
                </td>
                <td class="status-col">{{ status_badge(drug.status) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endif %}

{# ── Adverse events comparison ── #}
{% if vm.adverse_events %}
<div class="section">
    <h2>Adverse Events ({{ vm.adverse_events|length }})</h2>
    <div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Preferred Term</th>
                <th>Report 1: {{ vm.report_1_id }}</th>
                <th>Report 2: {{ vm.report_2_id }}</th>
                <th class="status-col"></th>
            </tr>
        </thead>
        <tbody>
        {% for ae in vm.adverse_events %}
            <tr class="{{ ae.status.value }}">
                <td><strong class="name-{{ ae.status.value }}">{{ ae.pt_name }}</strong></td>
                <td>
                    {% for d in ae.left_details %}
                    <div class="detail-block">
                        <span class="name-{{ ae.status.value }}">{{ d.pt_name }}</span>
                        {%- if d.start_date %} <span style="color:#586069;">({{ d.start_date }})</span>{% endif %}
                    </div>
                    {% endfor %}
                </td>
                <td>
                    {% for d in ae.right_details %}
                    <div class="detail-block">
                        <span class="name-{{ ae.status.value }}">{{ d.pt_name }}</span>
                        {%- if d.start_date %} <span style="color:#586069;">({{ d.start_date }})</span>{% endif %}
                    </div>
                    {% endfor %}
                </td>
                <td class="status-col">{{ status_badge(ae.status) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>
{% endif %}

{# ── Narratives ── #}
{% if vm.narratives.left_text or vm.narratives.right_text %}
<div class="section">
    <h2>Narratives</h2>
    <div class="narrative-grid">
        <div>
            <div class="narrative-col-header">Report 1: {{ vm.report_1_id }}</div>
            <div class="narrative-col">{{ vm.narratives.left_text or '--' }}</div>
        </div>
        <div>
            <div class="narrative-col-header">Report 2: {{ vm.report_2_id }}</div>
            <div class="narrative-col">{{ vm.narratives.right_text or '--' }}</div>
        </div>
    </div>
</div>
{% endif %}

{# ── Evidence summary (optional) ── #}
{% if vm.features_summary %}
<div class="section">
    <h2>Evidence Summary</h2>
    <dl class="evidence-kv">
        <dt>L<sub>match</sub></dt>
        <dd>{{ "%.4f"|format(vm.features_summary.l_match) }}</dd>
        <dt>Expected collisions</dt>
        <dd>{{ "%.4e"|format(vm.features_summary.expected_collisions) }}</dd>
        <dt>Anchor</dt>
        <dd>{{ vm.features_summary.anchor_type }} (N={{ vm.features_summary.anchor_n }})</dd>
        <dt>Reporting context</dt>
        <dd>{{ vm.features_summary.reporting_context }}</dd>
        <dt>Narrative consistency</dt>
        <dd>{{ vm.features_summary.narrative_consistency }}</dd>
        <dt>Matching drugs</dt>
        <dd>{{ vm.features_summary.matching_drugs|join(', ') or '--' }}</dd>
        <dt>Matching AEs</dt>
        <dd>{{ vm.features_summary.matching_aes|join(', ') or '--' }}</dd>
    </dl>

    {# ── Anchor details (extended) ── #}
    {% if vm.features_summary.anchor_n_drugs is not none %}
    <h3 style="font-size: 1rem; margin: 12px 0 6px;">Anchor Details</h3>
    <dl class="evidence-kv">
        <dt>Anchor type</dt>
        <dd>{{ vm.features_summary.anchor_type }}</dd>
        <dt>N<sub>anchor</sub></dt>
        <dd>{{ vm.features_summary.anchor_n }}</dd>
        <dt>N<sub>drugs</sub></dt>
        <dd>{{ vm.features_summary.anchor_n_drugs }}</dd>
        <dt>N<sub>AEs</sub></dt>
        <dd>{{ vm.features_summary.anchor_n_aes }}</dd>
        <dt>N<sub>drugs&times;AEs</sub></dt>
        <dd>{{ vm.features_summary.anchor_n_drugs_aes }}</dd>
    </dl>
    {% endif %}

    {# ── Probability details (extended) ── #}
    {% if vm.features_summary.p_joint is not none %}
    <h3 style="font-size: 1rem; margin: 12px 0 6px;">Probability Details</h3>
    <dl class="evidence-kv">
        <dt>p<sub>joint</sub></dt>
        <dd>{{ "%.4e"|format(vm.features_summary.p_joint) }}</dd>
        <dt>Expected collisions</dt>
        <dd>{{ "%.4e"|format(vm.features_summary.expected_collisions) }}</dd>
        <dt>L<sub>match</sub></dt>
        <dd>{{ "%.4f"|format(vm.features_summary.l_match) }}</dd>
    </dl>
    {% if vm.features_summary.feature_contributions %}
    <h4 style="font-size: 0.9rem; margin: 8px 0 4px; color: #586069;">Feature Contributions</h4>
    <table>
        <thead><tr><th>Feature</th><th>p<sub>f</sub></th><th>Method</th><th>Domain size</th><th>Description</th></tr></thead>
        <tbody>
        {% for fc in vm.features_summary.feature_contributions %}
        <tr>
            <td>{{ fc.feature }}</td>
            <td>{{ "%.4e"|format(fc.p_f) }}</td>
            <td>{{ fc.method }}</td>
            <td>{{ "%.0f"|format(fc.domain_size) if fc.domain_size is not none else '--' }}</td>
            <td>{{ fc.description }}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}
    {% endif %}

    {# ── AE clinical-picture status panel (LLM-assisted or rule-based) ── #}
    {% if vm.features_summary.ae_clinical_picture_status %}
    {%- set ae_status = vm.features_summary.ae_clinical_picture_status %}
    {%- set ae_counts = vm.features_summary.ae_clinical_picture_counts %}
    {%- set ae_method = vm.features_summary.ae_clinical_picture_method %}
    {%- set ae_rule = vm.features_summary.ae_clinical_picture_rule_details %}
    <div class="ae-cp-panel">
        <span class="label">AE clinical-picture:</span>
        <span class="ae-cp-status-{{ ae_status }}">{{ ae_status | replace('_', ' ') }}</span>
        {% if ae_method %}
        &nbsp;<span style="font-size: 12px; color: #586069;">[{{ ae_method | replace('_', ' ') }}]</span>
        {% endif %}
        {% if ae_status == 'assessed' and ae_counts %}
        &nbsp;&middot;&nbsp;
        {{ ae_counts.n_minor }} minor, {{ ae_counts.n_moderate }} moderate,
        {{ ae_counts.n_strong }} strong, {{ ae_counts.n_decisive }} decisive
        ({{ ae_counts.total }} kept)
        {% elif ae_status == 'not_assessed' and vm.features_summary.ae_clinical_picture_reason %}
        &nbsp;<span style="color: #586069; font-size: 12px;">({{ vm.features_summary.ae_clinical_picture_reason }})</span>
        {% endif %}
        {% if ae_status == 'assessed' and vm.features_summary.ae_clinical_picture_reasoning %}
        <details class="ae-cp-reasoning" style="margin-top: 4px;">
            <summary style="cursor: pointer; font-size: 12px; color: #586069;">LLM reasoning</summary>
            <div style="font-size: 12px; color: #24292e; white-space: pre-wrap; margin-top: 4px;">{{ vm.features_summary.ae_clinical_picture_reasoning }}</div>
        </details>
        {% endif %}
        {% if ae_rule %}
        <details class="ae-cp-rule-details" style="margin-top: 4px;">
            <summary style="cursor: pointer; font-size: 12px; color: #586069;">Rule-based audit (Step 1 / Step 2)</summary>
            <div style="font-size: 12px; color: #24292e; margin-top: 4px;">
                <div>
                    <strong>Step 1</strong> (symmetric, includes Investigations):
                    most-granular shared MedDRA level =
                    <code>{{ ae_rule.step1_overlap_level | upper }}</code>
                    &nbsp;&rarr;&nbsp;
                    {% if ae_rule.step1_severity %}
                        severity <code>{{ ae_rule.step1_severity }}</code>
                    {% else %}
                        no inconsistency
                    {% endif %}
                </div>
                <div style="margin-top: 2px;">
                    <strong>Step 2 R1 &rarr; R2</strong>:
                    U = {{ ae_rule.step2_r1_to_r2_u }},
                    M = {{ ae_rule.step2_r1_to_r2_m }},
                    severity =
                    {% if ae_rule.step2_r1_to_r2_severity %}
                        <code>{{ ae_rule.step2_r1_to_r2_severity }}</code>
                    {% else %}
                        none
                    {% endif %}
                </div>
                <div>
                    <strong>Step 2 R2 &rarr; R1</strong>:
                    U = {{ ae_rule.step2_r2_to_r1_u }},
                    M = {{ ae_rule.step2_r2_to_r1_m }},
                    severity =
                    {% if ae_rule.step2_r2_to_r1_severity %}
                        <code>{{ ae_rule.step2_r2_to_r1_severity }}</code>
                    {% else %}
                        none
                    {% endif %}
                </div>
                <div style="margin-top: 2px; color: #586069;">
                    Investigations SOC excluded from Step 2:
                    {{ 'yes' if ae_rule.investigations_excluded_step2 else 'no' }}
                </div>
                {% if ae_rule.missing_hierarchy_warnings %}
                <div style="margin-top: 2px; color: #b08800;">
                    Missing MedDRA hierarchy on:
                    {{ ae_rule.missing_hierarchy_warnings | join(', ') }}
                </div>
                {% endif %}
            </div>
        </details>
        {% endif %}
    </div>
    {% endif %}

    {# ── Discrepancies (all inconsistencies factored into the decision) ── #}
    {% if vm.features_summary.inconsistencies or vm.features_summary.clinical_date_findings %}
    <h3 style="font-size: 1rem; margin: 12px 0 6px;">Discrepancies</h3>
    {% if vm.features_summary.inconsistency_counts %}
    {%- set ic = vm.features_summary.inconsistency_counts %}
    <p style="font-size: 13px; color: #586069; margin: 0 0 6px;">
        Combined: {{ ic.minor }} minor, {{ ic.moderate }} moderate, {{ ic.strong }} strong, {{ ic.decisive }} decisive
        ({{ ic.total }} total)
    </p>
    {% endif %}
    <table>
        <thead><tr><th>Feature</th><th>Severity</th><th>Description</th></tr></thead>
        <tbody>
        {% for inc in vm.features_summary.inconsistencies %}
        <tr{% if inc.suppressed %} class="inc-suppressed"{% endif %}>
            <td>
                {{ inc.feature }}
                {% if inc.suppressed %}
                <span class="suppressed-badge" title="{{ inc.suppressed_by }}">suppressed</span>
                {% endif %}
            </td>
            <td><span class="severity-{{ inc.severity }}">{{ inc.severity }}</span></td>
            <td>
                {% if inc.description %}{{ inc.description }}{% endif %}
                {% if inc.rationale %}
                <div class="inc-rationale">{{ inc.rationale }}</div>
                {% endif %}
                {% if inc.terms %}
                <div class="inc-terms"><strong>Terms:</strong> {{ inc.terms | join(', ') }}</div>
                {% endif %}
                {% if inc.suppressed and inc.suppressed_by %}
                <div class="inc-rationale">Suppressed by: {{ inc.suppressed_by | replace('_', ' ') }}</div>
                {% endif %}
            </td>
        </tr>
        {% endfor %}
        {% for cdf in vm.features_summary.clinical_date_findings %}
        <tr>
            <td>{{ cdf.entity_label }}</td>
            <td><span class="severity-{{ cdf.severity }}">{{ cdf.severity }}</span></td>
            <td>{{ cdf.source_date }} vs {{ cdf.matched_date }}{% if cdf.diff_days is not none %}, diff={{ cdf.diff_days }}d{% endif %}{% if cdf.downgrades %} ({{ cdf.downgrades | join('; ') }}){% endif %}</td>
        </tr>
        {% endfor %}
        </tbody>
    </table>
    {% endif %}
</div>
{% endif %}

{# ── Frequency statistics ── #}
<div class="section">
    <h2>Frequency Statistics</h2>
    {% if vm.freq_stats and vm.freq_stats.scopes %}
    {%- set drugs_label = join_and(vm.freq_stats.matching_drugs) %}
    {%- set aes_label   = join_and(vm.freq_stats.matching_aes) %}
    <div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>Scope</th>
                <th>Total # reports</th>
                <th># reports on {{ drugs_label }}</th>
                {% if vm.freq_stats.matching_aes %}
                <th># reports with {{ aes_label }}</th>
                <th># reports on {{ drugs_label }} with {{ aes_label }}</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for scope in vm.freq_stats.scopes %}
            <tr>
                <td><strong>{{ scope.label }}</strong></td>
                <td>{{ scope.N_total }}</td>
                <td>{{ scope.N_drugs }}</td>
                {% if vm.freq_stats.matching_aes %}
                <td>{{ scope.N_AEs }}</td>
                <td>{{ scope.N_drugs_AEs }}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
    {% else %}
    <p style="color: #586069; font-size: 13px; margin: 4px 0;">Frequency statistics not available.</p>
    {% endif %}
</div>

{# ── Classification (optional) ── #}
{% if vm.classification_summary %}
<div class="section">
    <h2>Classification</h2>
    <dl class="evidence-kv">
        <dt>Independence</dt>
        <dd>{{ vm.classification_summary.independence_assessment }}</dd>
        {% if vm.classification_summary.duplicate_relationship %}
        <dt>Relationship</dt>
        <dd>{{ vm.classification_summary.duplicate_relationship }}</dd>
        {% endif %}
        <dt>Pipeline label</dt>
        <dd>
            <span class="label-badge label-{{ vm.classification_summary.final_label }}">
                {{ vm.classification_summary.final_label }}
            </span>
        </dd>
        {% if vm.annotation %}
        <dt>Human annotation</dt>
        <dd>
            <span class="label-badge label-{{ vm.annotation.normalised_label }}">
                {{ vm.annotation.normalised_label }}
            </span>
            {% if vm.annotation.agrees_with_pipeline is not none %}
            &nbsp;
            {% if vm.annotation.agrees_with_pipeline %}
            <span class="annotation-agree">&#10003; agree</span>
            {% else %}
            <span class="annotation-disagree">&#10007; disagree</span>
            {% endif %}
            {% endif %}
        </dd>
        {% endif %}
    </dl>
    {% if vm.classification_summary.explanation %}
    <p style="font-size: 13px; color: #586069; margin: 8px 0 0;">
        {{ vm.classification_summary.explanation }}
    </p>
    {% endif %}
    {% if vm.classification_summary.penalty_summary %}
    <p style="font-size: 13px; color: #586069; margin: 4px 0 0;">
        Penalty: {{ vm.classification_summary.penalty_summary }}
    </p>
    {% endif %}
</div>
{% elif vm.annotation %}
{# ── Annotation-only section (no pipeline classification) ── #}
<div class="section">
    <h2>Human Annotation</h2>
    <dl class="evidence-kv">
        <dt>Label</dt>
        <dd>
            <span class="label-badge label-{{ vm.annotation.normalised_label }}">
                {{ vm.annotation.normalised_label }}
            </span>
        </dd>
    </dl>
</div>
{% endif %}

{# ── Debug / raw data (collapsible) ── #}
{% if vm.debug_json %}
<div class="section">
    <h2>Debug / Raw Data</h2>
    <details class="debug-section">
        <summary>Show raw PairFeatures &amp; ClassificationResult JSON</summary>
        <pre>{{ vm.debug_json }}</pre>
    </details>
</div>
{% endif %}

<footer style="text-align: center; color: #959da5; font-size: 11px; margin-top: 24px;">
    Generated by llm_dup_dev.review_html
</footer>

</body>
</html>
