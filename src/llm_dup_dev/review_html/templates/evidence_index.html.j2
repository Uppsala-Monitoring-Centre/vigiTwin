{# Index over the generated evidence reviews. Links only the files written. #}<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width,initial-scale=1" name="viewport"/>
<title>{{ vm.title }}</title>
<style>
{% include "_evidence.css.j2" %}
</style>
</head>
<body>
<main>
  <div class="kicker">Evidence review</div>
  <h1>{{ vm.title }}</h1>
  <p class="note">
    {{ vm.items | length }} example{{ '' if vm.items | length == 1 else 's' }}{% if vm.generated_at %} · generated {{ vm.generated_at }}{% endif %}.
  </p>
  <table>
    <thead>
      <tr>
        <th scope="col">Example</th>
        <th scope="col">Title</th>
        <th scope="col">Reference</th>
        <th scope="col">vigiTwin</th>
      </tr>
    </thead>
    <tbody>
      {% for item in vm.items %}
      <tr>
        <td><a href="{{ item.filename }}">{{ item.example_label or item.example_id }}</a>
          {% if item.kicker %}<small class="subtle">{{ item.kicker }}</small>{% endif %}
        </td>
        <td>{{ item.title or item.pair_id }}</td>
        <td>{{ item.reference_label or "—" }}</td>
        <td>{{ item.final_label or "—" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <footer>
    Generated by vigiTwin (llm_dup_dev.review_html, evidence format). Internal
    evidence review; not a publication-safe document.
  </footer>
</main>
</body>
</html>
