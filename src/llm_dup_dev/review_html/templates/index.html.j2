<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Review Batch Index</title>
<style>
*, *::before, *::after { box-sizing: border-box; }
body {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    font-size: 14px;
    line-height: 1.5;
    color: #24292e;
    background: #f6f8fa;
    margin: 0;
    padding: 20px;
}
h1 { font-size: 1.5rem; margin: 0 0 4px; }
.header {
    background: #fff;
    border: 1px solid #d1d5da;
    border-radius: 6px;
    padding: 16px 20px;
    margin-bottom: 16px;
}
.meta { color: #586069; font-size: 0.92em; }
.section {
    background: #fff;
    border: 1px solid #d1d5da;
    border-radius: 6px;
    padding: 12px 20px 16px;
    margin-bottom: 16px;
}
.table-scroll { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th, td { border: 1px solid #d1d5da; padding: 6px 10px; text-align: left; }
thead th { background: #f1f3f5; font-weight: 600; position: sticky; top: 0; }
a { color: #0366d6; text-decoration: none; }
a:hover { text-decoration: underline; }

.label-badge { display: inline-block; padding: 1px 6px; border-radius: 3px; font-weight: 600; font-size: 12px; }
.label-Duplicates { background: #d4edda; color: #155724; }
.label-Otherwise_related { background: #fce4ec; color: #880e4f; }
.label-Unrelated { background: #721c24; color: #fff; }
.label-Abstain { background: #e2e3e5; color: #383d41; }

/* Source/case verdict badge (mirrors the pair-page style). */
.verdict-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 3px;
    background: #e7e1f5;
    color: #4527a0;
    font-size: 12px;
    font-weight: 600;
}
.source-case-line { margin-top: 3px; }
.source-case-line code { font-size: 11px; }

/* Explicit inter-report link badge. Green rather than the source/case
   purple: this is a declared link, not an inferred verdict. */
.link-badge {
    display: inline-block;
    padding: 1px 6px;
    border-radius: 3px;
    background: #dff5e1;
    color: #1b5e20;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
}
.link-line { margin-top: 3px; }
.link-line code { font-size: 11px; }

/* Severity badges for inline inconsistency items */
.inc-minor,
.inc-moderate,
.inc-strong,
.inc-decisive {
    display: inline-block;
    padding: 1px 5px;
    margin-bottom: 3px;
    border-radius: 3px;
    color: #fff;
    font-weight: 600;
}
.inc-minor    { background: #b8860b; }
.inc-moderate { background: #e67e22; }
.inc-strong   { background: #c0392b; }
.inc-decisive { background: #7b2cbf; font-weight: 700; }

/* Per-element L_match contribution chips (positive = green, anchor = red).
   Magnitudes binned identically across the two scales so reviewers learn one. */
.contrib {
    display: inline-block;
    padding: 1px 5px;
    margin-bottom: 2px;
    border-radius: 3px;
    font-weight: 600;
}
.contrib-pos-vw { background: #f1f8e9; color: #2e7d32; }
.contrib-pos-w  { background: #c5e1a5; color: #1b5e20; }
.contrib-pos-m  { background: #81c784; color: #1b5e20; }
.contrib-pos-s  { background: #4caf50; color: #fff; }
.contrib-pos-vs { background: #2e7d32; color: #fff; }
.contrib-neg-vw { background: #fdecea; color: #7b241c; }
.contrib-neg-w  { background: #f5b7b1; color: #641e16; }
.contrib-neg-m  { background: #ef6f6c; color: #fff; }
.contrib-neg-s  { background: #c0392b; color: #fff; }
.contrib-neg-vs { background: #7b241c; color: #fff; }

@media print { body { background: #fff; padding: 0; } }
</style>
</head>
<body>

<div class="header">
    <h1>Review Batch Index</h1>
    <div class="meta">{{ items|length }} pair{{ 's' if items|length != 1 else '' }} &middot; generated {{ generated_at }}</div>
</div>

<div class="section">
    <div class="table-scroll">
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Pair ID</th>
                {% if has_context %}
                <th>Context</th>
                {% endif %}
                {% if has_explicit_link %}
                <th>Explicit link</th>
                {% endif %}
                {% if has_anchor %}
                <th>Anchor</th>
                {% endif %}
                {% if has_anchor_n %}
                <th>Anchor N</th>
                {% endif %}
                {% if has_matching_features %}
                <th>Additional matching features</th>
                {% endif %}
                {% if has_l_match %}
                <th>L<sub>match</sub></th>
                {% endif %}
                {% if has_inconsistencies %}
                <th>Inconsistencies</th>
                {% endif %}
                {% if has_penalty %}
                <th>Penalty</th>
                {% endif %}
                {% if has_labels %}
                <th>Classification</th>
                {% endif %}
                {% if has_annotations %}
                <th>Human annotation</th>
                {% endif %}
            </tr>
        </thead>
        <tbody>
        {% for item in items %}
            <tr>
                <td>{{ loop.index }}</td>
                <td><a href="{{ item.filename }}">{{ item.pair_id }}</a></td>
                {% if has_context %}
                <td>
                    {{ item.context_label or '--' }}
                    {% if item.source_case %}
                    <div class="source-case-line">
                        <span class="verdict-badge" title="{{ item.source_case.verdict }}">
                            {{ item.source_case.short_label }}
                        </span>
                        {% if item.source_case.shared_source_identifier %}
                        <code>{{ item.source_case.shared_source_identifier_type or 'id' }}={{ item.source_case.shared_source_identifier }}</code>
                        {% endif %}
                    </div>
                    {% endif %}
                </td>
                {% endif %}
                {% if has_explicit_link %}
                <td>
                    {%- if item.explicit_link -%}
                    <span class="link-badge" title="{{ item.explicit_link.reasoning }}">
                        🔗 {{ item.explicit_link.short_label }}
                    </span>
                    {%- for match in item.explicit_link.matches %}
                    <div class="link-line">
                        <code>{{ match.target_kind_label }}={{ match.pointer_value }}</code>
                    </div>
                    {%- endfor -%}
                    {%- else -%}
                    --
                    {%- endif -%}
                </td>
                {% endif %}
                {% if has_anchor %}
                <td>{{ item.anchor_label | safe if item.anchor_label else '--' }}</td>
                {% endif %}
                {% if has_anchor_n %}
                <td>
                    {%- if item.anchor_n is not none -%}
                        {{ item.anchor_n }} reports
                        {%- if item.anchor_penalty is not none %}
                        <span class="contrib {{ item.anchor_penalty_class }}">(-{{ "%.1f"|format(-item.anchor_penalty) }})</span>
                        {%- endif %}
                    {%- else -%}
                        --
                    {%- endif -%}
                </td>
                {% endif %}
                {% if has_matching_features %}
                <td>{{ item.matching_features | safe if item.matching_features else '--' }}</td>
                {% endif %}
                {% if has_l_match %}
                <td>{{ "%.2f"|format(item.l_match) if item.l_match is not none else '--' }}</td>
                {% endif %}
                {% if has_inconsistencies %}
                <td>
                    {%- if item.inconsistency_items -%}
                    {%- for ii in item.inconsistency_items -%}
                    {%- if not loop.first %}<br>{% endif -%}
                    <span class="inc-{{ ii.severity }}">{{ ii.text | safe }}</span>
                    {%- endfor -%}
                    {%- endif -%}
                </td>
                {% endif %}
                {% if has_penalty %}
                <td>{{ item.penalty_text or '--' }}</td>
                {% endif %}
                {% if has_labels %}
                <td>
                    {% if item.final_label %}
                    <span class="label-badge label-{{ item.final_label }}">{{ item.final_label }}</span>
                    {% else %}
                    --
                    {% endif %}
                </td>
                {% endif %}
                {% if has_annotations %}
                <td>
                    {% if item.annotation_label %}
                    <span class="label-badge label-{{ item.annotation_label }}">{{ item.annotation_label }}</span>
                    {% if item.annotation_agrees is not none %}
                    {% if item.annotation_agrees %}
                    <span style="color:#155724;font-weight:700;">&#10003;</span>
                    {% else %}
                    <span style="color:#721c24;font-weight:700;">&#10007;</span>
                    {% endif %}
                    {% endif %}
                    {% else %}
                    --
                    {% endif %}
                </td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
</div>

<footer style="text-align: center; color: #959da5; font-size: 11px; margin-top: 24px;">
    Generated by llm_dup_dev.review_html
</footer>

</body>
</html>
