{
  "$defs": {
    "ReferencePair": {
      "description": "One report pair in a reference set.\n\n``reference_label`` is the human annotator's verdict; it is required for a\nprecision set and absent (or ``\"duplicate\"``) for a recall set. ``cluster_id``\nis optional provenance metadata \u2014 the secure side has already reduced each\ncluster to at most one pair, so the dev side only sanity-checks it.",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "report_id1": {
          "title": "Report Id1",
          "type": "string"
        },
        "report_id2": {
          "title": "Report Id2",
          "type": "string"
        },
        "cluster_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster Id"
        },
        "reference_label": {
          "anyOf": [
            {
              "enum": [
                "duplicate",
                "non_duplicate",
                "abstain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Label"
        },
        "annotator_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotator Id"
        },
        "annotated_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annotated At"
        }
      },
      "required": [
        "pair_id",
        "report_id1",
        "report_id2"
      ],
      "title": "ReferencePair",
      "type": "object"
    },
    "SamplingRecord": {
      "description": "A reproducible record of one seeded SCLE sampling draw.\n\nEverything needed to reproduce or audit a draw: the procedure, the exact\nseed string handed to :class:`random.Random`, the package/python versions,\nthe available population per stratum, and the resulting selection in draw\norder. The protocol requires that \"the randomization procedure and seed will\nbe recorded\"; this is that record.\n\nThe dev side only samples SCLE cases (the recall/precision reference sets are\nconstructed on the secure side), so this record describes a stratified SCLE\ndraw \u2014 not any cluster-construction sampling.",
      "properties": {
        "procedure_id": {
          "title": "Procedure Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "package_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Version"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        },
        "per_stratum_target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Stratum Target"
        },
        "stratum_sizes": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Stratum Sizes",
          "type": "object"
        },
        "selected_pair_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Pair Ids",
          "type": "array"
        },
        "backup_pair_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Backup Pair Ids",
          "type": "object"
        }
      },
      "required": [
        "procedure_id",
        "seed",
        "created_at"
      ],
      "title": "SamplingRecord",
      "type": "object"
    }
  },
  "description": "A generic reference set with a declared role and provenance.\n\n``role`` selects the analysis: ``\"precision\"`` sets are the screening\nmethod's candidate set with per-pair human labels; ``\"recall\"`` sets are\nheld-out positive controls (known duplicates). ``provenance`` describes the\nset as a whole \u2014 each set is homogeneous in provenance (the secure side\nsends one set per provenance), so there is no per-pair provenance here.\n``sampling_record`` optionally carries the secure side's construction record.\n\n``screening_mode`` declares whether screening performance is part of this\nset's estimand (see :data:`ScreeningMode`). It is per set, never global, and\nis never inferred \u2014 ``not_evaluated`` must be selected explicitly. Only a\nrecall set may use it: a precision set *is* the screening method's candidate\nset, so \"screening was not evaluated\" cannot describe one.",
  "properties": {
    "set_id": {
      "title": "Set Id",
      "type": "string"
    },
    "role": {
      "enum": [
        "precision",
        "recall"
      ],
      "title": "Role",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "provenance": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provenance"
    },
    "screening_mode": {
      "default": "observed",
      "enum": [
        "observed",
        "not_evaluated"
      ],
      "title": "Screening Mode",
      "type": "string"
    },
    "sampling_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/SamplingRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/ReferencePair"
      },
      "title": "Pairs",
      "type": "array"
    }
  },
  "required": [
    "set_id",
    "role",
    "pairs"
  ],
  "title": "ReferenceSet",
  "type": "object"
}
