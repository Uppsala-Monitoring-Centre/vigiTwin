{
  "$defs": {
    "ArbitrationDecision": {
      "description": "The arbiter's resolution for one pair.\n\n``consensus_dimensions`` carries a value only for the structured dimensions\nthe arbiter chose to set (required for those that disagreed; ignored for\nthose that already agreed). ``free_text_materially_different`` records the\narbiter's judgement on the two free-text assessments.",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "consensus_dimensions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Consensus Dimensions",
          "type": "object"
        },
        "free_text_materially_different": {
          "title": "Free Text Materially Different",
          "type": "boolean"
        },
        "consensus_free_text": {
          "title": "Consensus Free Text",
          "type": "string"
        },
        "arbiter_rationale": {
          "title": "Arbiter Rationale",
          "type": "string"
        }
      },
      "required": [
        "pair_id",
        "consensus_dimensions",
        "free_text_materially_different",
        "consensus_free_text",
        "arbiter_rationale"
      ],
      "title": "ArbitrationDecision",
      "type": "object"
    },
    "ArbitrationSubmission": {
      "description": "The arbiter's complete set of decisions for one component.\n\n``structured_dimensions`` is the dimension set the workbook was written for,\nrecovered from the workbook itself on read-back.",
      "properties": {
        "arbitration_id": {
          "title": "Arbitration Id",
          "type": "string"
        },
        "arbiter_id": {
          "title": "Arbiter Id",
          "type": "string"
        },
        "evaluation_component": {
          "title": "Evaluation Component",
          "type": "string"
        },
        "sample_checksum": {
          "title": "Sample Checksum",
          "type": "string"
        },
        "structured_dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Structured Dimensions",
          "type": "array"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/ArbitrationDecision"
          },
          "title": "Decisions",
          "type": "array"
        }
      },
      "required": [
        "arbitration_id",
        "arbiter_id",
        "evaluation_component",
        "sample_checksum",
        "decisions"
      ],
      "title": "ArbitrationSubmission",
      "type": "object"
    },
    "CaseDifficulty": {
      "description": "How hard correct binary classification would be for the method.\n\n* ``trivial`` \u2014 expected to be very rare. Duplicate identification is\n  inherently ambiguous, so reserve this for pairs where nothing is left to\n  judge: the reports match exactly, carry sufficient information, and are\n  explicitly linked to one another.\n* ``clear`` \u2014 the correct label is clear to a human reviewer, but arriving at\n  it is not trivial for a computational method. Two reports whose narratives\n  plainly describe the same case belong here, because the method would still\n  have to extract that information reliably.\n* ``non_trivial`` \u2014 genuinely difficult to classify.\n* ``unclear`` \u2014 so difficult that the reviewer would have abstained.",
      "enum": [
        "trivial",
        "clear",
        "non_trivial",
        "unclear"
      ],
      "title": "CaseDifficulty",
      "type": "string"
    },
    "ConsensusAssessment": {
      "description": "The resolved assessment for one pair, with per-dimension provenance.\n\nStructured dimension values are stored as their string form (enum value, or\n``None`` when the dimension does not apply). ``dimension_sources`` maps each\nstructured dimension to ``reviewer_agreement`` or ``arbitration``; since the\nerror stages are one dimension each, their provenance is recorded per stage\neven though the resolved answers collapse into the ``error_stages`` list.\n\nFree text is never merged automatically: both reviewers' assessments are\nretained in ``reviewer_free_texts``. ``consensus_free_text`` holds the\narbiter's text for a pair that went to arbitration (a structural\ndisagreement); it is empty for an agreement pair, where the two reviewer\ntexts stand on their own.",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "case_difficulty": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Difficulty"
        },
        "reference_label_issue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Label Issue"
        },
        "never_event": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Never Event"
        },
        "unexpected_method_behaviour": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unexpected Method Behaviour"
        },
        "incorrect_or_imprecise_input_data": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Incorrect Or Imprecise Input Data"
        },
        "error_stages": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Error Stages",
          "type": "array"
        },
        "implicated_feature_domains": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Implicated Feature Domains",
          "type": "array"
        },
        "dimension_sources": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Dimension Sources",
          "type": "object"
        },
        "reviewer_free_texts": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Reviewer Free Texts",
          "type": "object"
        },
        "consensus_free_text": {
          "default": "",
          "title": "Consensus Free Text",
          "type": "string"
        },
        "free_text_materially_different": {
          "default": false,
          "title": "Free Text Materially Different",
          "type": "boolean"
        },
        "arbiter_rationale": {
          "default": "",
          "title": "Arbiter Rationale",
          "type": "string"
        },
        "arbitrated": {
          "default": false,
          "title": "Arbitrated",
          "type": "boolean"
        }
      },
      "required": [
        "pair_id"
      ],
      "title": "ConsensusAssessment",
      "type": "object"
    },
    "DimensionDisagreement": {
      "description": "A single dimension on which the two reviewers differ.",
      "properties": {
        "field": {
          "title": "Field",
          "type": "string"
        },
        "value_a": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value A"
        },
        "value_b": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value B"
        }
      },
      "required": [
        "field",
        "value_a",
        "value_b"
      ],
      "title": "DimensionDisagreement",
      "type": "object"
    },
    "DiscrepancyReport": {
      "description": "The structured-disagreement picture between two submissions.\n\n``structured_dimensions`` records the dimensions actually compared, in\nworkbook order, so downstream steps reproduce exactly this set.",
      "properties": {
        "evaluation_component": {
          "title": "Evaluation Component",
          "type": "string"
        },
        "reviewer_a": {
          "title": "Reviewer A",
          "type": "string"
        },
        "reviewer_b": {
          "title": "Reviewer B",
          "type": "string"
        },
        "structured_dimensions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Structured Dimensions",
          "type": "array"
        },
        "pair_discrepancies": {
          "items": {
            "$ref": "#/$defs/PairDiscrepancy"
          },
          "title": "Pair Discrepancies",
          "type": "array"
        }
      },
      "required": [
        "evaluation_component",
        "reviewer_a",
        "reviewer_b",
        "pair_discrepancies"
      ],
      "title": "DiscrepancyReport",
      "type": "object"
    },
    "PairDiscrepancy": {
      "description": "All structured disagreements on one pair (empty list means full agreement).",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "dimension_disagreements": {
          "items": {
            "$ref": "#/$defs/DimensionDisagreement"
          },
          "title": "Dimension Disagreements",
          "type": "array"
        }
      },
      "required": [
        "pair_id",
        "dimension_disagreements"
      ],
      "title": "PairDiscrepancy",
      "type": "object"
    },
    "ReferenceLabelIssue": {
      "description": "Whether the reference label looks sound, suspect, or genuinely ambiguous.",
      "enum": [
        "no_apparent_issue",
        "possibly_incorrect",
        "genuinely_ambiguous"
      ],
      "title": "ReferenceLabelIssue",
      "type": "string"
    },
    "ReviewerSubmission": {
      "description": "A single reviewer's complete set of assessments for one component.\n\n``sample_checksum`` is the sha256 of the ``SCLESample`` JSON the workbook\nwas generated from, tying the submission to the exact sampled case list so a\nstale or mismatched workbook is caught on read-back.\n\n``error_stages`` and ``feature_domains`` are the study's frozen vocabularies\nas embedded in the workbook the submission was read from. They travel with\nthe submission so that agreement, discrepancy detection, arbitration, and\nconsensus can derive the dimension set from the data rather than having the\nconfiguration threaded into each of them.",
      "properties": {
        "workbook_id": {
          "title": "Workbook Id",
          "type": "string"
        },
        "reviewer_id": {
          "title": "Reviewer Id",
          "type": "string"
        },
        "evaluation_component": {
          "enum": [
            "precision",
            "recall"
          ],
          "title": "Evaluation Component",
          "type": "string"
        },
        "sample_checksum": {
          "title": "Sample Checksum",
          "type": "string"
        },
        "error_stages": {
          "items": {
            "type": "string"
          },
          "title": "Error Stages",
          "type": "array"
        },
        "feature_domains": {
          "items": {
            "type": "string"
          },
          "title": "Feature Domains",
          "type": "array"
        },
        "assessments": {
          "items": {
            "$ref": "#/$defs/SCLECaseAssessment"
          },
          "title": "Assessments",
          "type": "array"
        }
      },
      "required": [
        "workbook_id",
        "reviewer_id",
        "evaluation_component",
        "sample_checksum",
        "assessments"
      ],
      "title": "ReviewerSubmission",
      "type": "object"
    },
    "SCLECaseAssessment": {
      "description": "One reviewer's assessment of one SCLE case.\n\nConditional dimensions are ``None`` (or an empty list) when they do not\napply. The model enforces *internal* consistency \u2014 the required\nmisclassification dimensions are all-present or all-absent. The full check\nthat presence matches the paired :class:`SCLEAutoContext` is done by\n:func:`check_assessment_against_context`, because the model does not carry\nthe context; validation of the two list-valued fields against the study's\nfrozen vocabularies happens at workbook read-back, which is where those\nlists are available.",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "reviewer_id": {
          "title": "Reviewer Id",
          "type": "string"
        },
        "free_text_assessment": {
          "title": "Free Text Assessment",
          "type": "string"
        },
        "case_difficulty": {
          "$ref": "#/$defs/CaseDifficulty"
        },
        "reference_label_issue": {
          "$ref": "#/$defs/ReferenceLabelIssue"
        },
        "never_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/YesNo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "unexpected_method_behaviour": {
          "anyOf": [
            {
              "$ref": "#/$defs/YesNo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "incorrect_or_imprecise_input_data": {
          "anyOf": [
            {
              "$ref": "#/$defs/YesNo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error_source_description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Source Description"
        },
        "error_stages": {
          "items": {
            "type": "string"
          },
          "title": "Error Stages",
          "type": "array"
        },
        "implicated_feature_domains": {
          "items": {
            "type": "string"
          },
          "title": "Implicated Feature Domains",
          "type": "array"
        },
        "method_difference_explanation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method Difference Explanation"
        }
      },
      "required": [
        "pair_id",
        "reviewer_id",
        "free_text_assessment",
        "case_difficulty",
        "reference_label_issue"
      ],
      "title": "SCLECaseAssessment",
      "type": "object"
    },
    "YesNo": {
      "description": "Binary answer used by every yes/no misclassification dimension.",
      "enum": [
        "yes",
        "no"
      ],
      "title": "YesNo",
      "type": "string"
    }
  },
  "description": "The complete consensus record for one evaluation component.\n\nHolds the two original reviews verbatim (with their checksums), the\nstructured discrepancy report, the arbitration, the resolved consensus, and\nthe list of pairs flagged for a possible reference-label issue.",
  "properties": {
    "evaluation_component": {
      "title": "Evaluation Component",
      "type": "string"
    },
    "reviewer_submissions": {
      "items": {
        "$ref": "#/$defs/ReviewerSubmission"
      },
      "title": "Reviewer Submissions",
      "type": "array"
    },
    "submission_checksums": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Submission Checksums",
      "type": "object"
    },
    "discrepancy_report": {
      "$ref": "#/$defs/DiscrepancyReport"
    },
    "arbitration": {
      "$ref": "#/$defs/ArbitrationSubmission"
    },
    "consensus": {
      "items": {
        "$ref": "#/$defs/ConsensusAssessment"
      },
      "title": "Consensus",
      "type": "array"
    },
    "reference_label_concerns": {
      "items": {
        "type": "string"
      },
      "title": "Reference Label Concerns",
      "type": "array"
    }
  },
  "required": [
    "evaluation_component",
    "reviewer_submissions",
    "submission_checksums",
    "discrepancy_report",
    "arbitration",
    "consensus",
    "reference_label_concerns"
  ],
  "title": "SCLEConsensusResult",
  "type": "object"
}
