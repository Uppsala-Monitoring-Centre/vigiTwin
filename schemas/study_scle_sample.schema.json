{
  "$defs": {
    "SCLEAutoContext": {
      "description": "Case context populated from the frozen results, never by reviewers.\n\nCarries everything the reviewer should *see but not assess*: the reference\nlabel, the method output, the confusion cell (precision) or joint stratum\n(recall), whether the methods disagree, whether the case is a\nmisclassification by the adjudicator, a short decision-trace summary, and\nthe packet filename. ``is_misclassified`` and ``methods_disagree`` drive the\napplicability of the conditional dimensions.",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "evaluation_component": {
          "enum": [
            "precision",
            "recall"
          ],
          "title": "Evaluation Component",
          "type": "string"
        },
        "reference_set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Set Id"
        },
        "reference_label": {
          "title": "Reference Label",
          "type": "string"
        },
        "adjudicator_final_label": {
          "title": "Adjudicator Final Label",
          "type": "string"
        },
        "screening_retrieved": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Screening Retrieved"
        },
        "confusion_cell": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confusion Cell"
        },
        "joint_stratum": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Joint Stratum"
        },
        "methods_disagree": {
          "title": "Methods Disagree",
          "type": "boolean"
        },
        "is_misclassified": {
          "title": "Is Misclassified",
          "type": "boolean"
        },
        "decision_trace_summary": {
          "default": "",
          "title": "Decision Trace Summary",
          "type": "string"
        },
        "packet_filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packet Filename"
        }
      },
      "required": [
        "pair_id",
        "evaluation_component",
        "reference_label",
        "adjudicator_final_label",
        "methods_disagree",
        "is_misclassified"
      ],
      "title": "SCLEAutoContext",
      "type": "object"
    },
    "SCLECase": {
      "description": "One sampled SCLE case: a pair plus its stratum and auto-context.\n\n``backup_rank`` is ``None`` for a primary pick, or a 1-based rank within its\nstratum for a backup (backups are consulted in ascending rank order when a\nprimary pair is disqualified).",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "evaluation_component": {
          "enum": [
            "precision",
            "recall"
          ],
          "title": "Evaluation Component",
          "type": "string"
        },
        "reference_set_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Set Id"
        },
        "stratum": {
          "title": "Stratum",
          "type": "string"
        },
        "backup_rank": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backup Rank"
        },
        "auto_context": {
          "$ref": "#/$defs/SCLEAutoContext"
        }
      },
      "required": [
        "pair_id",
        "evaluation_component",
        "stratum",
        "auto_context"
      ],
      "title": "SCLECase",
      "type": "object"
    },
    "SamplingRecord": {
      "description": "A reproducible record of one seeded SCLE sampling draw.\n\nEverything needed to reproduce or audit a draw: the procedure, the exact\nseed string handed to :class:`random.Random`, the package/python versions,\nthe available population per stratum, and the resulting selection in draw\norder. The protocol requires that \"the randomization procedure and seed will\nbe recorded\"; this is that record.\n\nThe dev side only samples SCLE cases (the recall/precision reference sets are\nconstructed on the secure side), so this record describes a stratified SCLE\ndraw \u2014 not any cluster-construction sampling.",
      "properties": {
        "procedure_id": {
          "title": "Procedure Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "package_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Version"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        },
        "per_stratum_target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Per Stratum Target"
        },
        "stratum_sizes": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Stratum Sizes",
          "type": "object"
        },
        "selected_pair_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Pair Ids",
          "type": "array"
        },
        "backup_pair_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Backup Pair Ids",
          "type": "object"
        }
      },
      "required": [
        "procedure_id",
        "seed",
        "created_at"
      ],
      "title": "SamplingRecord",
      "type": "object"
    }
  },
  "description": "The SCLE cases drawn for one evaluation component.\n\n``cases`` are the primary picks (what goes into the reviewer workbook).\n``backups`` are the ordered reserve pairs per stratum, drawn from the same\npermutation, used to replace a disqualified primary pick. ``records`` holds\none :class:`SamplingRecord` per stratum, so the exact sub-seed and available\npopulation size are auditable.",
  "properties": {
    "evaluation_component": {
      "enum": [
        "precision",
        "recall"
      ],
      "title": "Evaluation Component",
      "type": "string"
    },
    "cases": {
      "items": {
        "$ref": "#/$defs/SCLECase"
      },
      "title": "Cases",
      "type": "array"
    },
    "backups": {
      "items": {
        "$ref": "#/$defs/SCLECase"
      },
      "title": "Backups",
      "type": "array"
    },
    "records": {
      "items": {
        "$ref": "#/$defs/SamplingRecord"
      },
      "title": "Records",
      "type": "array"
    }
  },
  "required": [
    "evaluation_component",
    "cases",
    "backups",
    "records"
  ],
  "title": "SCLESample",
  "type": "object"
}
