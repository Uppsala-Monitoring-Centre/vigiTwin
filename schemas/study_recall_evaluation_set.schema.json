{
  "$defs": {
    "RecallPairRecord": {
      "description": "One reference-duplicate pair sampled from a recall reference set.\n\nEvery recall pair is a positive control (a known duplicate), so there is no\nper-pair reference label. ``cluster_id`` is required because recall\nsampling draws one pair per duplicate cluster. ``provenance`` distinguishes\nmanually classified pairs from E2B-field-linked pairs (the Spanish and\nDutch sets contain both, and the protocol prioritises manual pairs).\n``eligible`` records whether the pair belongs to the held-out test portion.",
      "properties": {
        "pair_id": {
          "title": "Pair Id",
          "type": "string"
        },
        "report_id1": {
          "title": "Report Id1",
          "type": "string"
        },
        "report_id2": {
          "title": "Report Id2",
          "type": "string"
        },
        "cluster_id": {
          "title": "Cluster Id",
          "type": "string"
        },
        "provenance": {
          "default": "unspecified",
          "enum": [
            "manual",
            "e2b_derived",
            "unspecified"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "eligible": {
          "default": true,
          "title": "Eligible",
          "type": "boolean"
        }
      },
      "required": [
        "pair_id",
        "report_id1",
        "report_id2",
        "cluster_id"
      ],
      "title": "RecallPairRecord",
      "type": "object"
    },
    "SamplingRecord": {
      "description": "A reproducible record of one seeded sampling draw.\n\nEverything needed to reproduce or audit a draw: the procedure, the exact\nseed string handed to :class:`random.Random`, the package/python versions,\nand the resulting selection in draw order. The protocol requires that \"the\nrandomization procedure and seed will be recorded\"; this is that record.",
      "properties": {
        "procedure_id": {
          "title": "Procedure Id",
          "type": "string"
        },
        "seed": {
          "title": "Seed",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "package_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Package Version"
        },
        "python_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Python Version"
        },
        "target": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "n_eligible_clusters": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "N Eligible Clusters"
        },
        "tier_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Tier Counts",
          "type": "object"
        },
        "stratum_sizes": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Stratum Sizes",
          "type": "object"
        },
        "selected_pair_ids": {
          "items": {
            "type": "string"
          },
          "title": "Selected Pair Ids",
          "type": "array"
        }
      },
      "required": [
        "procedure_id",
        "seed",
        "created_at"
      ],
      "title": "SamplingRecord",
      "type": "object"
    }
  },
  "description": "One regulator-derived recall reference set (e.g. FDA Gold).\n\n``reference_set_id`` is validated against :data:`KNOWN_REFERENCE_SETS` with\na warning (not an error) for unknown ids, keeping the package generic.",
  "properties": {
    "reference_set_id": {
      "title": "Reference Set Id",
      "type": "string"
    },
    "reference_set_label": {
      "title": "Reference Set Label",
      "type": "string"
    },
    "sampling_record": {
      "anyOf": [
        {
          "$ref": "#/$defs/SamplingRecord"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "pairs": {
      "items": {
        "$ref": "#/$defs/RecallPairRecord"
      },
      "title": "Pairs",
      "type": "array"
    }
  },
  "required": [
    "reference_set_id",
    "reference_set_label",
    "pairs"
  ],
  "title": "RecallEvaluationSet",
  "type": "object"
}
