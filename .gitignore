# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/

# Virtual environments
venv/
.env
.venv/

# Environment files
.env
.env.*

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Generated output (review_html.render.DEFAULT_OUTPUT_DIR renders here)
outputs/

# Azure / secrets
*.pem
*.key
*.crt

# Data files
*.csv
*.parquet
*.pkl
*.feather
*.json
*.xlsx

# Allow JSON schemas and examples to be tracked
!schemas/*.json
!examples/*.json

# Read-only secure-side architectural references — never tracked
_reference_secure_side/
# Coverage artifacts. Unlike the pytest/ruff/mypy caches, which each write a
# self-ignoring .gitignore into their own directory, coverage.py does not — so
# without these entries a `git add -A` sweeps .coverage into a commit. It is a
# SQLite database of absolute local paths, which is not something to publish.
.coverage
.coverage.*
coverage.xml
htmlcov/
